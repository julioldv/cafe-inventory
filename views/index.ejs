
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cafe Inventory | Categories</title>
</head>
<body>
    <main>
        <header>
            <h1>All categories from Cafe Inventory</h1>
            <a href="/categories/new">Create category</a>
        </header>

        <section>
            <h2>Categories</h2>

            <% if (categories.length === 0) { %>
                <p>No categories registered yet.</p>
            <% } else { %>
                <% categories.forEach(category => { %>
                    <article>
                        <h3>
                            <a href="/categories/<%= category.id %>">
                                <%= category.name %>
                            </a>
                        </h3>
                        <p><%= category.description %></p>
                    </article>
                <% }); %>
            <% } %>
        </section>
    </main>
</body>
</html>
