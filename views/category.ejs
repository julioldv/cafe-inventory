<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= category.name %> | Cafe Inventory</title>
</head>
<body>
    <main>
        <header>
            <h1><%= category.name %></h1>
        </header>
        <div>
            <% if (items.length === 0) { %>
            <p>This category has no items yet.</p>
            <% } else { %>
            <ul>
                <% items.forEach(item => { %>
                <li><%= item.name %></li>
                <% }); %>
            </ul>
            <% } %>
        </div>

    </main>
</body>
</html>